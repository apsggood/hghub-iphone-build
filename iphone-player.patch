diff --git a/src-tauri/src/ios_show_player.m b/src-tauri/src/ios_show_player.m
new file mode 100644
--- /dev/null
+++ b/src-tauri/src/ios_show_player.m
@@ -0,0 +1,21 @@
+#import <SafariServices/SafariServices.h>
+#import <UIKit/UIKit.h>
+#include <stdint.h>
+
+int32_t hghub_present_show(void *controller, uint64_t showID) {
+    UIViewController *host = (__bridge UIViewController *)controller;
+    if (!NSThread.isMainThread || !host.viewIfLoaded.window || showID == 0) {
+        return 0;
+    }
+    if (host.presentedViewController) {
+        return [host.presentedViewController isKindOfClass:SFSafariViewController.class] ? 1 : 0;
+    }
+    // The upstream share button opens the show's public page. Episode selection is on that page.
+    NSString *address = [NSString stringWithFormat:@"https://huangguoai.com/video/%llu/", (unsigned long long)showID];
+    NSURL *url = [NSURL URLWithString:address];
+    SFSafariViewController *player = [[SFSafariViewController alloc] initWithURL:url];
+    player.modalPresentationStyle = UIModalPresentationFullScreen;
+    player.dismissButtonStyle = SFSafariViewControllerDismissButtonStyleDone;
+    [host presentViewController:player animated:YES completion:nil];
+    return 1;
+}
