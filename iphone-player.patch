+#import <UIKit/UIKit.h>
+#import <WebKit/WebKit.h>
+#import <objc/runtime.h>
+
+extern int32_t hghub_sync_inline(void *host, uint64_t showID, const double *rect);
+
+// Exercise the production view with a local clip. Record the requested URL and
+// substitute only the initial network request, so the simulator needs no site login.
+static NSString *requestedPath;
+static WKNavigation *loadFixture(WKWebView *view, SEL selector, NSURLRequest *request) {
+    requestedPath = request.URL.absoluteString;
+    NSURL *page = [NSBundle.mainBundle URLForResource:@"fixture" withExtension:@"html"];
+    return [view loadFileURL:page allowingReadAccessToURL:page.URLByDeletingLastPathComponent];
+}
+static void finish(NSString *result) {
+    NSString *path = [NSHomeDirectory() stringByAppendingPathComponent:@"Documents/result.txt"];
+    [result writeToFile:path atomically:YES encoding:NSUTF8StringEncoding error:nil];
+}
+@interface SmokeApp : UIResponder <UIApplicationDelegate>
+@property(nonatomic, strong) UIWindow *window;
+@property(nonatomic, strong) WKWebView *host;
+@end
+@implementation SmokeApp
+- (BOOL)application:(UIApplication *)application didFinishLaunchingWithOptions:(NSDictionary *)options {
+    method_setImplementation(class_getInstanceMethod(WKWebView.class, @selector(loadRequest:)), (IMP)loadFixture);
+    self.window = [[UIWindow alloc] initWithFrame:UIScreen.mainScreen.bounds];
+    UIViewController *root = [UIViewController new];
+    self.host = [[WKWebView alloc] initWithFrame:self.window.bounds];
+    root.view = self.host;
+    self.window.rootViewController = root;
+    [self.window makeKeyAndVisible];
+    [self performSelector:@selector(start) withObject:nil afterDelay:0.5];
+    return YES;
+}
+- (void)start {
+    double rect[] = {0, 0.2, 1, 0.7};
+    if (!hghub_sync_inline((__bridge void *)self.host, 81, rect)) { finish(@"mount failed"); return; }
+    UIView *box = self.host.subviews.lastObject;
+    WKWebView *web = (id)box.subviews.firstObject;
+    if (![web isKindOfClass:WKWebView.class] || !web.configuration.allowsInlineMediaPlayback ||
+        ![requestedPath isEqual:@"https://huangguoai.com/video/81/"] ||
+        fabs(box.frame.origin.y - self.host.bounds.size.width * .2) > 1) { finish(@"wrong view or frame"); return; }
+    [self poll:web box:box tries:70];
+}
+- (void)poll:(WKWebView *)web box:(UIView *)box tries:(NSInteger)tries {
+    NSString *js = @"(() => {const v=document.querySelector('video');return !!v && v.playsInline && v.currentTime>0 && v.webkitPresentationMode==='inline'})()";
+    [web evaluateJavaScript:js completionHandler:^(id playing, NSError *error) {
+        if (!error && [playing boolValue]) {
+            void *host = (__bridge void *)self.host;
+            double resized[] = {.05, .12, .9, .8};
+            double hidden[] = {0, 0, 0, 0};
+            hghub_sync_inline(host, 81, hidden);
+            BOOL hid = box.hidden;
+            hghub_sync_inline(host, 81, resized);
+            hghub_sync_inline(host, 80, NULL);
+            if (!hid || box.hidden || self.host.subviews.lastObject != box ||
+                box.subviews.firstObject != web || self.window.rootViewController.presentedViewController) {
+                finish(@"resize replaced player or presented a new screen"); return;
+            }
+            hghub_sync_inline(host, 82, resized);
+            UIView *next = self.host.subviews.lastObject;
+            if (box.superview || next == box || ![requestedPath hasSuffix:@"/82/"]) { finish(@"switch failed"); return; }
+            hghub_sync_inline(host, 81, NULL);
+            if (!next.superview) { finish(@"stale cleanup removed current show"); return; }
+            hghub_sync_inline(host, 82, NULL);
+            finish(next.superview ? @"cleanup failed" : @"PASS inline video played without presenting a controller; resize, switch and cleanup passed");
+        } else if (tries > 0) {
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 250*NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+                [self poll:web box:box tries:tries-1];
+            });
+        } else {
+            [web evaluateJavaScript:@"String(document.querySelector('video')?.error?.message || document.querySelector('video')?.webkitPresentationMode || document.readyState)" completionHandler:^(id detail, NSError *e) {
+                finish([NSString stringWithFormat:@"inline video did not play: %@ %@", detail, e ?: @""]);
+            }];
+        }
+    }];
+}
+@end
+int main(int argc, char **argv) {
+    @autoreleasepool { return UIApplicationMain(argc, argv, nil, NSStringFromClass(SmokeApp.class)); }
+}
