diff --git a/src-tauri/src/ios_show_player.m b/src-tauri/src/ios_show_player.m
new file mode 100644
--- /dev/null
+++ b/src-tauri/src/ios_show_player.m
@@ -0,0 +1,101 @@
+#import <UIKit/UIKit.h>
+#import <WebKit/WebKit.h>
+#import <objc/runtime.h>
+#include <stdint.h>
+
+// A child of the app's web view, with its own configuration and no app script handlers.
+@interface HGInlineShowView : UIView <WKNavigationDelegate>
+@property(nonatomic, readonly) uint64_t showID;
+@property(nonatomic, strong) WKWebView *web;
+@property(nonatomic, strong) NSURL *showURL;
+@property(nonatomic, strong) UIButton *retry;
+@end
+
+@implementation HGInlineShowView
+- (instancetype)initWithShowID:(uint64_t)showID {
+    self = [super initWithFrame:CGRectZero];
+    if (!self) return nil;
+    _showID = showID;
+    self.clipsToBounds = YES;
+    self.backgroundColor = UIColor.blackColor;
+    WKWebViewConfiguration *config = [WKWebViewConfiguration new];
+    config.allowsInlineMediaPlayback = YES;
+    config.mediaTypesRequiringUserActionForPlayback = WKAudiovisualMediaTypeNone;
+    config.preferences.javaScriptCanOpenWindowsAutomatically = NO;
+    // The inline attribute also applies to video elements created after the page loads.
+    NSString *inlineVideo = @"const mark = el => { if (el.tagName === 'VIDEO') el.playsInline = true; };"
+        "new MutationObserver(records => { for (const r of records) for (const el of r.addedNodes) {"
+        " if (el.nodeType !== 1) continue; mark(el); el.querySelectorAll('video').forEach(mark);"
+        "} }).observe(document, {subtree:true, childList:true});";
+    [config.userContentController addUserScript:[[WKUserScript alloc] initWithSource:inlineVideo
+        injectionTime:WKUserScriptInjectionTimeAtDocumentStart forMainFrameOnly:NO
+        inContentWorld:WKContentWorld.defaultClientWorld]];
+    _web = [[WKWebView alloc] initWithFrame:self.bounds configuration:config];
+    _web.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+    _web.navigationDelegate = self;
+    _web.scrollView.contentInsetAdjustmentBehavior = UIScrollViewContentInsetAdjustmentNever;
+    [self addSubview:_web];
+    _retry = [UIButton buttonWithType:UIButtonTypeSystem];
+    [_retry setTitle:@"播放頁載入失敗，點此重試" forState:UIControlStateNormal];
+    _retry.backgroundColor = UIColor.systemBackgroundColor;
+    _retry.translatesAutoresizingMaskIntoConstraints = NO;
+    [_retry addTarget:self action:@selector(loadShow) forControlEvents:UIControlEventTouchUpInside];
+    [self addSubview:_retry];
+    [NSLayoutConstraint activateConstraints:@[
+        [_retry.centerXAnchor constraintEqualToAnchor:self.centerXAnchor],
+        [_retry.centerYAnchor constraintEqualToAnchor:self.centerYAnchor],
+        [_retry.heightAnchor constraintGreaterThanOrEqualToConstant:44],
+    ]];
+    _showURL = [NSURL URLWithString:[NSString stringWithFormat:@"https://huangguoai.com/video/%llu/", (unsigned long long)showID]];
+    [self loadShow];
+    return self;
+}
+- (void)loadShow {
+    self.retry.hidden = YES;
+    [self.web loadRequest:[NSURLRequest requestWithURL:self.showURL]];
+}
+- (void)webView:(WKWebView *)view didFailProvisionalNavigation:(WKNavigation *)navigation withError:(NSError *)error {
+    if (![error.domain isEqualToString:NSURLErrorDomain] || error.code != NSURLErrorCancelled) self.retry.hidden = NO;
+}
+- (void)webView:(WKWebView *)view didFailNavigation:(WKNavigation *)navigation withError:(NSError *)error {
+    [self webView:view didFailProvisionalNavigation:navigation withError:error];
+}
+- (void)webViewWebContentProcessDidTerminate:(WKWebView *)view { self.retry.hidden = NO; }
+- (void)webView:(WKWebView *)view didFinishNavigation:(WKNavigation *)navigation { self.retry.hidden = YES; }
+- (void)detach {
+    self.web.navigationDelegate = nil;
+    [self.web stopLoading];
+    [self.web pauseAllMediaPlaybackWithCompletionHandler:nil];
+    [self removeFromSuperview];
+}
+@end
+
+static char playerKey;
+int32_t hghub_sync_inline(void *hostPointer, uint64_t showID, const double *frame) {
+    WKWebView *host = (__bridge WKWebView *)hostPointer;
+    if (!NSThread.isMainThread || !host) return 0;
+    HGInlineShowView *player = objc_getAssociatedObject(host, &playerKey);
+    if (!frame) {
+        if (player && player.showID == showID) {
+            [player detach];
+            objc_setAssociatedObject(host, &playerKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        }
+        return 1;
+    }
+    CGFloat scale = host.bounds.size.width;
+    CGRect rect = CGRectIntersection(host.bounds, CGRectMake(frame[0]*scale, frame[1]*scale, frame[2]*scale, frame[3]*scale));
+    if (CGRectIsEmpty(rect)) {
+        if (player.showID == showID) player.hidden = YES;
+        return 1;
+    }
+    if (!host.window) return 0;
+    if (!player || player.showID != showID) {
+        [player detach];
+        player = [[HGInlineShowView alloc] initWithShowID:showID];
+        objc_setAssociatedObject(host, &playerKey, player, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        [host addSubview:player];
+    }
+    player.frame = rect;
+    player.hidden = NO;
+    return 1;
+}
