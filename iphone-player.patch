diff --git a/src-tauri/src/show_player.rs b/src-tauri/src/show_player.rs
new file mode 100644
--- /dev/null
+++ b/src-tauri/src/show_player.rs
@@ -0,0 +1,27 @@
+#[tauri::command]
+pub async fn open_show_player(window: tauri::WebviewWindow, id: u64) -> Result<(), String> {
+    #[cfg(target_os = "ios")]
+    {
+        if id == 0 {
+            return Err("找不到這部劇".into());
+        }
+        extern "C" {
+            fn hghub_present_show(controller: *mut std::ffi::c_void, id: u64) -> i32;
+        }
+        let (sender, receiver) = tokio::sync::oneshot::channel();
+        window.with_webview(move |webview| {
+            // Tauri runs this closure on the UI thread and owns the controller for its duration.
+            let presented = unsafe { hghub_present_show(webview.view_controller(), id) };
+            let _ = sender.send(presented);
+        }).map_err(|_| "無法連接播放畫面".to_string())?;
+        match receiver.await {
+            Ok(1) => Ok(()),
+            _ => Err("請關閉目前的彈出視窗，再開啟劇集頁".into()),
+        }
+    }
+    #[cfg(not(target_os = "ios"))]
+    {
+        let _ = (window, id);
+        Err("此播放視窗只適用於 iOS".into())
+    }
+}
