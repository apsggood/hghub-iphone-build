+#!/bin/bash
+set -euo pipefail
+app="$RUNNER_TEMP/InlineSmoke.app"
+bundle="dev.hghub.inline-smoke"
+mkdir -p "$app"
+device=$(xcrun simctl list devices available -j | python3 -c 'import json,sys; rows=json.load(sys.stdin)["devices"]; print(next(d["udid"] for rt,ds in sorted(rows.items(), reverse=True) if "iOS" in rt for d in ds if d["name"].startswith("iPhone")))')
+xcrun simctl boot "$device"
+xcrun simctl bootstatus "$device" -b
+sdk=$(xcrun --sdk iphonesimulator --show-sdk-path)
+xcrun --sdk iphonesimulator clang -fobjc-arc -target "$(uname -m)-apple-ios15.0-simulator" -isysroot "$sdk" \
+    tests/ios-inline/Smoke.m src-tauri/src/ios_show_player.m -framework Foundation -framework UIKit -framework WebKit -framework CoreGraphics -o "$app/InlineSmoke"
+cp tests/ios-inline/fixture.html "$app/"
+python3 - "$app" "$bundle" <<'PY'
+import base64, pathlib, plistlib, sys
+app = pathlib.Path(sys.argv[1])
+(app / "sample.mp4").write_bytes(base64.b64decode(pathlib.Path("tests/ios-inline/sample.b64").read_bytes()))
+with (app / "Info.plist").open("wb") as f:
+    plistlib.dump(dict(CFBundleExecutable="InlineSmoke", CFBundleIdentifier=sys.argv[2], CFBundlePackageType="APPL", CFBundleName="InlineSmoke", CFBundleVersion="1", CFBundleShortVersionString="1.0", MinimumOSVersion="15.0", UIDeviceFamily=[1], LSRequiresIPhoneOS=True, UILaunchScreen={}), f)
+PY
+codesign --force --sign - "$app"
+xcrun simctl install "$device" "$app"
+xcrun simctl launch "$device" "$bundle"
+data=$(xcrun simctl get_app_container "$device" "$bundle" data)
+for i in {1..80}; do
+    if [[ -f "$data/Documents/result.txt" ]]; then
+        cat "$data/Documents/result.txt"
+        grep -q '^PASS ' "$data/Documents/result.txt"
+        exit $?
+    fi
+    sleep 1
+done
+echo "Inline playback test did not finish."
+exit 1
