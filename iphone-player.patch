--- /dev/null
+++ b/src-tauri/src/show_player.rs
@@ -0,0 +1,28 @@
+#[tauri::command]
+pub async fn sync_show_player(window: tauri::WebviewWindow, id: u64, frame: Option<[f64; 4]>) -> Result<(), String> {
+    #[cfg(target_os = "ios")]
+    {
+        if id == 0 || frame.iter().flatten().any(|n| !n.is_finite()) {
+            return Err("無效的播放器位置".into());
+        }
+        extern "C" {
+            fn hghub_sync_inline(host: *mut std::ffi::c_void, id: u64, frame: *const f64) -> i32;
+        }
+        let (sender, receiver) = tokio::sync::oneshot::channel();
+        window.with_webview(move |webview| {
+            let rect = frame.as_ref().map_or(std::ptr::null(), |r| r.as_ptr());
+            // Tauri runs this callback on the UI thread. Both pointers live through the call.
+            let ok = unsafe { hghub_sync_inline(webview.inner(), id, rect) };
+            let _ = sender.send(ok);
+        }).map_err(|e| e.to_string())?;
+        match receiver.await {
+            Ok(1) => Ok(()),
+            _ => Err("無法載入內嵌播放器".into()),
+        }
+    }
+    #[cfg(not(target_os = "ios"))]
+    {
+        let _ = (window, id, frame);
+        Err("此播放器只適用於 iOS".into())
+    }
+}
