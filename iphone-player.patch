diff --git a/src/components/InlineShowPlayer.tsx b/src/components/InlineShowPlayer.tsx
new file mode 100644
--- /dev/null
+++ b/src/components/InlineShowPlayer.tsx
@@ -0,0 +1,64 @@
+import { useEffect, useRef, useState } from "react";
+import { api } from "../api";
+
+// UIKit work is asynchronous. Sequence removals and mounts across the feed stack.
+let nativeQueue = Promise.resolve();
+
+export default function InlineShowPlayer({ id }: { id: number }) {
+  const slot = useRef<HTMLDivElement>(null);
+  const [attempt, setAttempt] = useState(0);
+  const [failed, setFailed] = useState(false);
+  useEffect(() => {
+    const el = slot.current!;
+    const scroller = el.closest("section")!.parentElement!;
+    let disposed = false;
+    let raf = 0;
+    let revision = 0;
+    let last = "";
+    const send = (frame: number[] | null) => {
+      const key = JSON.stringify(frame);
+      if (key === last) return;
+      last = key;
+      const version = ++revision;
+      nativeQueue = nativeQueue.then(async () => {
+        if (!disposed && revision === version) await api.syncShowPlayer(id, frame);
+      }).catch(() => { if (!disposed && revision === version) setFailed(true); });
+    };
+    const measure = () => {
+      raf = 0;
+      const r = el.getBoundingClientRect();
+      const section = el.closest("section")!.getBoundingClientRect();
+      const view = scroller.getBoundingClientRect();
+      const w = window.innerWidth;
+      if (document.hidden || w < 1 || r.width < 1 || r.height < 1) { send(null); return; }
+      // Hide the native surface during a swipe so it never covers the neighbouring card.
+      if (Math.abs(section.top - view.top) > 1) { send([0, 0, 0, 0]); return; }
+      send([r.left, r.top, r.width, r.height].map(n => n / w));
+    };
+    const schedule = () => { if (!raf) raf = requestAnimationFrame(measure); };
+    const visibility = () => { if (document.hidden) send(null); else schedule(); };
+    const resize = new ResizeObserver(schedule);
+    resize.observe(el);
+    scroller.addEventListener("scroll", schedule, { passive: true });
+    window.addEventListener("resize", schedule);
+    document.addEventListener("animationend", schedule, true);
+    document.addEventListener("visibilitychange", visibility);
+    schedule();
+    return () => {
+      disposed = true;
+      cancelAnimationFrame(raf);
+      resize.disconnect();
+      scroller.removeEventListener("scroll", schedule);
+      window.removeEventListener("resize", schedule);
+      document.removeEventListener("animationend", schedule, true);
+      document.removeEventListener("visibilitychange", visibility);
+      nativeQueue = nativeQueue.then(() => api.syncShowPlayer(id, null)).catch(() => {});
+    };
+  }, [id, attempt]);
+  return (
+    <div ref={slot} aria-label="劇集播放器" className="absolute inset-0 grid place-items-center bg-black">
+      {failed ? <button className="min-h-11 px-4 text-white" onClick={() => { setFailed(false); setAttempt(n => n + 1); }}>重新載入播放頁</button>
+        : <div className="w-8 h-8 spinner" role="status" aria-label="載入播放頁" />}
+    </div>
+  );
+}
